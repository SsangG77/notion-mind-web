# Notion OAuth (Public Integration) — notion.so/my-integrations 에서 발급
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Supabase — supabase.com 프로젝트 설정에서 발급
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 토큰 암호화 키 (openssl rand -hex 32)
TOKEN_ENCRYPTION_KEY=

# Paddle (결제, 판매대행) — vendors.paddle.com > 개발자 도구 > 인증 / 알림
NEXT_PUBLIC_PADDLE_ENV=sandbox
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
# 샌드박스 카탈로그 가격 ID (라이브 ID 는 src/lib/paddle.ts 에 고정)
NEXT_PUBLIC_PADDLE_SANDBOX_PRICE_MONTHLY=
NEXT_PUBLIC_PADDLE_SANDBOX_PRICE_YEARLY=
